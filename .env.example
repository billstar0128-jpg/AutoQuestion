# Load explicitly with: python main.py --env-file .env
# Existing process environment variables take precedence.
HOTKEY=F8
EXIT_KEY=ESC
DEBOUNCE_MS=400
INPUT_MODE=vision
# AUTO: INPUT_MODE=auto; managed foreground DOM first, acquisition-only Vision fallback.
# AUTO does not start Chromium by default. Use main.py --open-demo for local DOM testing.
# Full AUTO requires LLM_PROVIDER=openai and LLM_SUPPORTS_VISION=true.
# DOM development: INPUT_MODE=dom and LLM_PROVIDER=fake (no API key required).
# Chromium runtime: PLAYWRIGHT_BROWSERS_PATH=0; python -m playwright install chromium
IMAGE_MAX_EDGE=2048
LLM_PROVIDER=openai
# Used only when LLM_PROVIDER=openai. Never commit real credentials.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_SUPPORTS_VISION=true
LLM_TIMEOUT_SECONDS=30
# Future feature, unused in this version.
AUTO_ACTION=false
